# Non-secret settings only. Put credentials in the local accounts file instead:
#   python -m trading_agent secrets init && python -m trading_agent secrets set alpaca.api_key_id
# (~/.config/stock-trading-agent/accounts.toml, chmod 600, outside git; see docs/ACCOUNTS.md)
#
# paper        = local simulator (default, no keys needed)
# alpaca-paper = Alpaca paper account (real market data, fake money)
# alpaca-live  = REAL MONEY. Requires --i-understand-live-trading on every command.
TRADING_MODE=paper

ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Claude agent (ANTHROPIC_API_KEY, or run `ant auth login`)
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=high

# Ask for y/N confirmation on every order. Always enforced in live mode.
REQUIRE_APPROVAL=true

PAPER_STARTING_CASH=100000
PAPER_STATE_FILE=data/paper_account.json
JOURNAL_FILE=data/trade_journal.jsonl
# RISK_CONFIG=config/risk.toml

# ---- Broker MCP servers (config/mcp_servers.toml, docs/MCP.md) ----
# Comma list to connect on every run, or pass --mcp alpaca,webull
MCP_SERVERS=
# Alpaca official MCP server reuses ALPACA_API_KEY_ID / ALPACA_API_SECRET_KEY above
ALPACA_PAPER_TRADE=true
# Webull official MCP server (uat = sandbox, prod = live)
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_REGION_ID=us
WEBULL_ENVIRONMENT=uat
WEBULL_MAX_ORDER_NOTIONAL_USD=10000
# Robinhood Agentic Trading MCP (OAuth access token; real money)
ROBINHOOD_MCP_TOKEN=
# Fidelity: no official MCP server. Only set these for an unofficial server you've reviewed.
FIDELITY_MCP_COMMAND=
FIDELITY_MCP_ARGS=
