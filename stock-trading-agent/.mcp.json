{
  "mcpServers": {
    "trading-agent": {
      "command": "python",
      "args": ["-m", "trading_agent", "mcp", "serve"],
      "env": {
        "TRADING_MODE": "${TRADING_MODE:-paper}"
      }
    },
    "alpaca": {
      "command": "uvx",
      "args": ["alpaca-mcp-server"],
      "env": {
        "ALPACA_API_KEY": "${ALPACA_API_KEY_ID:-}",
        "ALPACA_SECRET_KEY": "${ALPACA_API_SECRET_KEY:-}",
        "ALPACA_PAPER_TRADE": "${ALPACA_PAPER_TRADE:-true}"
      }
    },
    "webull": {
      "command": "uvx",
      "args": ["webull-openapi-mcp", "serve"],
      "env": {
        "WEBULL_APP_KEY": "${WEBULL_APP_KEY:-}",
        "WEBULL_APP_SECRET": "${WEBULL_APP_SECRET:-}",
        "WEBULL_REGION_ID": "${WEBULL_REGION_ID:-us}",
        "WEBULL_ENVIRONMENT": "${WEBULL_ENVIRONMENT:-uat}",
        "WEBULL_MAX_ORDER_NOTIONAL_USD": "${WEBULL_MAX_ORDER_NOTIONAL_USD:-10000}"
      }
    }
  }
}
